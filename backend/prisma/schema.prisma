// Generator
generator client {
  provider = "prisma-client-js"
}

// Datasource
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum OrganisationRole {
  BOARD_ADMIN
  CHAIR
  SECRETARY
  BOARD_MEMBER
  EXECUTIVE
  GUEST
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AgendaStatus {
  DRAFT
  PUBLISHED
}

enum MinutesStatus {
  NOT_STARTED
  DRAFT
  IN_REVIEW
  CONFIRMED
}

enum AgendaItemPurpose {
  NONE
  FOR_NOTING
  FOR_DECISION
  FOR_DISCUSSION
}

enum ConflictAction {
  ABSTAINED
  LEFT_ROOM
  NOTED
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum NotificationType {
  MEETING_CREATED
  MEETING_UPDATED
  MEETING_CANCELLED
  AGENDA_PUBLISHED
  MINUTES_CONFIRMED
  ACTION_ITEM_ASSIGNED
  DOCUMENT_UPLOADED
  TENURE_EXPIRING
}

enum ResolutionStatus {
  DRAFT
  OPEN
  PASSED
  FAILED
  CANCELLED
}

enum VoteStatus {
  IN_FAVOUR
  AGAINST
  ABSTAIN
}

enum DecisionStatus {
  OPEN
  CLOSED
}

enum DecisionOutcome {
  PASSED
  FAILED
  TIED
}

enum BoardPackStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  name                 String
  mobileNumber         String?
  title                String?
  suffix               String?
  avatarUrl            String?
  /// Bcrypt-hashed password — set once auth module is built.
  passwordHash         String?
  /// Token used for password resets
  resetPasswordToken   String?
  /// Expiration time for the password reset token
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships          OrganisationMember[]
  assignedActionItems  MinutesActionItem[]  @relation("ActionAssignee")
  auditLogs            AuditLog[]
  notifications        Notification[]
  votes                Vote[]
  decisionVotes        DecisionVote[]
  createdDecisions     Decision[]           @relation("DecisionCreator")
  committeeMemberships CommitteeMember[]
  interests            Interest[]
  minutesSignatures    MinutesSignature[]
  meetingAttendees     MeetingAttendee[]
  uploadedDocuments    Document[]           @relation("DocumentUploader")
  uploadedVersions     DocumentVersion[]    @relation("VersionUploader")
  documentAccesses     DocumentAccess[]
  meetingConflicts     MeetingConflict[]

  @@map("users")
}

model Organisation {
  id        String   @id @default(uuid())
  name      String
  /// Per-org notification preferences (stored as JSON for flexibility)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       OrganisationMember[]
  meetings      Meeting[]
  documents     Document[]
  auditLogs     AuditLog[]
  notifications Notification[]
  decisions     Decision[]
  resolutions   Resolution[]
  committees    Committee[]
  annualPlans   AnnualPlan[]
  interests     Interest[]
  locations     MeetingLocation[]
  folders       DocumentFolder[]
  boardPacks    BoardPack[]

  @@map("organisations")
}

model MeetingLocation {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  address        String
  timeZone       String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("meeting_locations")
}

model DocumentFolder {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@index([organisationId])
  @@map("document_folders")
}

model OrganisationMember {
  id             String           @id @default(uuid())
  organisationId String
  userId         String
  role           OrganisationRole @default(BOARD_MEMBER)
  designation    String?
  joinedAt       DateTime         @default(now())
  // tenureEndDate  String? /// ISO date "YYYY-MM-DD"

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  agendaItemAccess AgendaItemAccess[]

  /// A user may only have one membership record per organisation.
  @@unique([organisationId, userId])
  @@index([organisationId])
  @@index([userId])
  @@map("organisation_members")
}

model Meeting {
  id               String        @id @default(uuid())
  organisationId   String
  title            String
  date             String /// ISO date "YYYY-MM-DD"
  startTime        String /// "HH:MM"
  endTime          String /// "HH:MM"
  timeZone         String? /// IANA timezone, null means legacy floating time
  location         String
  videoLink        String?
  isRemote         Boolean       @default(false)
  administrator    String? /// Free-text until People module exists
  notes            String?
  status           MeetingStatus @default(DRAFT)
  agendaStatus     AgendaStatus  @default(DRAFT)
  committeeId      String?
  committeeVisible Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  committee      Committee?        @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  agendaSections AgendaSection[]
  minutes        Minutes?
  documents      Document[]
  decisions      Decision[]
  attendees      MeetingAttendee[]
  boardPacks     BoardPack[]
  conflicts      MeetingConflict[]

  @@index([organisationId])
  @@index([date])
  @@map("meetings")
}

model MeetingAttendee {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  rsvp      String?  @default("PENDING") // 'ACCEPTED', 'DECLINED', 'TENTATIVE', 'PENDING'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
  @@map("meeting_attendees")
}

model AgendaSection {
  id        String   @id @default(uuid())
  meetingId String
  title     String
  /// Display order within the meeting agenda (0-based)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  items   AgendaItem[]

  @@index([meetingId])
  @@map("agenda_sections")
}

model AgendaItem {
  id              String            @id @default(uuid())
  sectionId       String
  title           String
  purpose         AgendaItemPurpose @default(NONE)
  presenter       String?
  durationMinutes Int               @default(5)
  planItemId      String?
  /// Display order within the section (0-based)
  position        Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  section     AgendaSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  planItem    PlanItem?          @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  documents   Document[]
  accessRules AgendaItemAccess[]
  conflicts   MeetingConflict[]

  @@index([sectionId])
  @@index([planItemId])
  @@map("agenda_items")
}

model AgendaItemAccess {
  id           String @id @default(uuid())
  agendaItemId String
  memberId     String

  agendaItem AgendaItem         @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  member     OrganisationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([agendaItemId, memberId])
  @@index([agendaItemId])
  @@map("agenda_item_access")
}

model Minutes {
  id        String        @id @default(uuid())
  meetingId String        @unique
  status    MinutesStatus @default(NOT_STARTED)
  content   String? /// Freeform rich-text or JSON from editor
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  meeting     Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  actionItems MinutesActionItem[]
  signatures  MinutesSignature[]

  @@map("minutes")
}

model MinutesSignature {
  id            String   @id @default(uuid())
  minutesId     String
  signerId      String
  signedAt      DateTime @default(now())
  signatureHash String

  minutes Minutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  signer  User    @relation(fields: [signerId], references: [id], onDelete: Cascade)

  @@unique([minutesId, signerId])
  @@map("minutes_signatures")
}

model MinutesActionItem {
  id          String           @id @default(uuid())
  minutesId   String
  description String
  assigneeId  String? /// nullable — may be unassigned
  dueDate     String? /// ISO date "YYYY-MM-DD"
  status      ActionItemStatus @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  minutes  Minutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  assignee User?   @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([minutesId])
  @@index([assigneeId])
  @@map("minutes_action_items")
}

model Document {
  id               String   @id @default(uuid())
  organisationId   String
  meetingId        String?
  agendaItemId     String?
  folderId         String?
  fileName         String
  /// Original filename supplied by the uploader
  originalName     String
  mimeType         String
  /// Size in bytes
  sizeBytes        Int
  /// Storage path (local filesystem or S3 key)
  storagePath      String
  uploadedById     String?
  committeeId      String?
  committeeVisible Boolean  @default(false)
  createdAt        DateTime @default(now())

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  committee    Committee?      @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  meeting      Meeting?        @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  agendaItem   AgendaItem?     @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)
  folder       DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy   User?           @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  versions    DocumentVersion[]
  accessRules DocumentAccess[]

  @@index([organisationId])
  @@index([meetingId])
  @@index([agendaItemId])
  @@index([folderId])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(uuid())
  documentId   String
  version      Int
  storagePath  String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("VersionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

model DocumentAccess {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([documentId])
  @@map("document_access")
}

model BoardPack {
  id             String          @id @default(uuid())
  organisationId String
  meetingId      String
  status         BoardPackStatus @default(DRAFT)
  version        Int             @default(1)
  storagePath    String?
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  meeting      Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([meetingId])
  @@map("board_packs")
}

model AuditLog {
  id             String   @id @default(uuid())
  organisationId String
  actorId        String? /// nullable — system actions have no actor
  action         String /// e.g. "meeting.created", "agenda.published"
  entityType     String /// e.g. "Meeting", "AgendaSection"
  entityId       String
  /// Before/after snapshot stored as JSON for full auditability
  payload        Json?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id             String           @id @default(uuid())
  organisationId String
  recipientId    String
  type           NotificationType
  title          String
  message        String
  isRead         Boolean          @default(false)
  /// Plain string following the AuditLog entityType/entityId pattern — no polymorphic FK.
  entityType     String?
  entityId       String?
  createdAt      DateTime         @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  recipient    User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([organisationId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Decision {
  id               String           @id @default(uuid())
  organisationId   String
  meetingId        String?
  createdById      String?
  title            String
  description      String?
  date             String /// ISO date "YYYY-MM-DD"
  status           DecisionStatus   @default(OPEN)
  outcome          DecisionOutcome?
  votingEndsAt     DateTime? // optional deadline for voting
  committeeId      String?
  committeeVisible Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  committee    Committee?     @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  meeting      Meeting?       @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("DecisionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  votes        DecisionVote[]

  @@index([organisationId])
  @@index([meetingId])
  @@map("decisions")
}

model DecisionVote {
  id         String     @id @default(uuid())
  decisionId String
  voterId    String
  vote       VoteStatus
  comment    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  voter    User     @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([decisionId, voterId])
  @@index([decisionId])
  @@index([voterId])
  @@map("decision_votes")
}

model Resolution {
  id             String           @id @default(uuid())
  organisationId String
  title          String
  description    String
  status         ResolutionStatus @default(DRAFT)
  closeDate      String /// ISO date "YYYY-MM-DD"
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  votes        Vote[]

  @@index([organisationId])
  @@map("resolutions")
}

model Vote {
  id           String     @id @default(uuid())
  resolutionId String
  voterId      String
  status       VoteStatus
  comment      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  resolution Resolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  voter      User       @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([resolutionId, voterId])
  @@index([resolutionId])
  @@index([voterId])
  @@map("votes")
}

model Committee {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  members      CommitteeMember[]
  meetings     Meeting[]
  documents    Document[]
  decisions    Decision[]

  @@index([organisationId])
  @@map("committees")
}

model CommitteeMember {
  id          String   @id @default(uuid())
  committeeId String
  userId      String
  role        String   @default("MEMBER") /// e.g., "CHAIR", "MEMBER"
  createdAt   DateTime @default(now())

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([committeeId, userId])
  @@index([committeeId])
  @@index([userId])
  @@map("committee_members")
}

model AnnualPlan {
  id             String   @id @default(uuid())
  organisationId String
  year           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  items        PlanItem[]

  @@unique([organisationId, year])
  @@index([organisationId])
  @@map("annual_plans")
}

model PlanItem {
  id           String   @id @default(uuid())
  annualPlanId String
  title        String
  description  String?
  month        Int /// 1-12
  status       String   @default("TODO") /// "TODO", "IN_PROGRESS", "DONE"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  annualPlan  AnnualPlan   @relation(fields: [annualPlanId], references: [id], onDelete: Cascade)
  agendaItems AgendaItem[]

  @@index([annualPlanId])
  @@map("annual_plan_items")
}

model Interest {
  id               String   @id @default(uuid())
  organisationId   String
  userId           String? /// Optional for external guests
  guestName        String? /// Name of the external person if userId is null
  title            String
  description      String?
  notificationDate String? /// ISO date "YYYY-MM-DD"
  isResolved       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organisation     Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingConflicts MeetingConflict[]

  @@index([organisationId])
  @@index([userId])
  @@map("interests")
}

model MeetingConflict {
  id           String         @id @default(uuid())
  meetingId    String
  agendaItemId String?
  userId       String
  interestId   String?
  description  String?
  actionTaken  ConflictAction @default(NOTED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  meeting    Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  agendaItem AgendaItem? @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest?   @relation(fields: [interestId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([userId])
  @@map("meeting_conflicts")
}
